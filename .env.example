# Copy this file to .env and fill in values. Never commit the real .env.

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Set in production; leave empty only for local development.
API_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Database ---
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Dev default (SQLite, zero setup):
DATABASE_URL=sqlite:///./data/dev.db
# Production (Postgres via docker-compose), uncomment when you get to Phase 11:
# DATABASE_URL=postgresql+psycopg2://docint:docint@localhost:5432/docint

# --- Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp,docx,xlsx,csv

# --- Vector DB (Phase 4) ---
# "local" = embedded on-disk Qdrant, no server needed (dev/test default).
# "server" = real Qdrant instance at QDRANT_URL (docker-compose's `qdrant`
# service — switch to this for Phase 11 / production).
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=document_chunks

# --- Embeddings (Phase 4) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=12
# Use the dependency-free local hashing fallback when FlagEmbedding/torch
# or the BGE-M3 model weights are unavailable. Set false for strict mode.
EMBEDDING_FALLBACK_ENABLED=true

# --- Reranker (Phase 5) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANK_ENABLED=true

# --- OCR (Phase 3) ---
OCR_MODEL=PaddleOCR-VL-1.6
OCR_PIPELINE_VERSION=v1.6
OCR_DEVICE=cpu
OCR_RENDER_DPI=200
OCR_ENABLE_PREPROCESSING=true

# --- Ingestion / chunking (Phase 2) ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
SCANNED_PDF_MIN_CHARS_PER_PAGE=20

# --- LLM (Phase 6) — set ONE provider and its key ---
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=local-extractive
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
# Base URLs below rarely need changing — override only for a self-hosted /
# proxy / regional endpoint. Only the one matching LLM_PROVIDER is used.
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Retrieval tuning (Phase 5) ---
RETRIEVAL_TOP_K_CANDIDATES=40
RETRIEVAL_RERANK_POOL=20
RETRIEVAL_TOP_K_FINAL=8
RRF_K=60
